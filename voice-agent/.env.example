# Local development: copy to .env.local (gitignored). Both the worker and the web tier read it.

# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=

# Databricks (AWS) workspace. Either DATABRICKS_HOST + DATABRICKS_TOKEN, or DATABRICKS_CONFIG_PROFILE.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
# DATABRICKS_CONFIG_PROFILE=aws

# Models on Unity AI Gateway
HUB_LLM_MODEL=system.ai.gpt-5-nano
HUB_LLM_REASONING_EFFORT=low
HUB_EMBED_MODEL=system.ai.gte-large-en
HUB_EMBED_DIM=1024

# Lakebase (leave LAKEBASE_ENDPOINT blank to use the bundled catalog only)
LAKEBASE_ENDPOINT=
LAKEBASE_DATABASE=databricks_postgres
HUB_SCHEMA=hub

# Tracing (optional; all three or none)
HUB_TRACE_CATALOG=
HUB_TRACE_SCHEMA=
HUB_TRACE_TABLE_PREFIX=hub_concierge

AGENT_NAME=hub-concierge
